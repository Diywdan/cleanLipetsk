# Скопировать в .env командой: python scripts/bootstrap_env.py
# Значения generate-me скрипт заменит случайными секретами. .env в git не попадает.

# --- База ---
# В compose адрес собирается из POSTGRES_PASSWORD; для запуска без Docker — свой URL.
POSTGRES_PASSWORD=generate-me
# CRM_DATABASE_URL=sqlite:///data/crm.db

# --- Публикация ---
CRM_BIND_HOST=127.0.0.1
CRM_HOST_PORT=18080
CRM_INTEGRATION_DOCKER_NETWORK=plo_integrations

# --- Вход в админку ---
# Первый администратор создаётся при старте, если такого логина ещё нет.
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD=generate-me
CRM_SESSION_SECRET=generate-me
CRM_SESSION_TTL_SECONDS=28800
# true, когда CRM открыта по HTTPS
CRM_COOKIE_SECURE=false

# --- Data Gateway ---
# READ — справочники и назначения (в DG: CRM_READ_TOKEN).
# WRITE — регистрация инженеров и сопряжение (в DG: CRM_WRITE_TOKEN и setup-токен в UI «Подключить CRM»).
CRM_DG_READ_TOKEN=generate-me
CRM_DG_WRITE_TOKEN=generate-me
# Ключ подписи вебхука. Пусто — CRM берёт ключ, присланный DG при сопряжении.
CRM_DG_WEBHOOK_SIGNING_SECRET=
CRM_DG_WEBHOOK_MAX_SKEW_SECONDS=300
# Адрес DG, у которого CRM берёт свежую ссылку на файл (видео, незабранные снимки). Пусто — из сопряжения.
# CRM_DG_MEDIA_URL=http://<контейнер DG>:<порт>

# --- Разное ---
CRM_INBOX_INTERVAL_SECONDS=2
# Демо-участки и четыре демо-инженера с телефонами +7999000xxxx — только для стенда.
CRM_SEED_DEMO=false
CRM_LOG_LEVEL=info
