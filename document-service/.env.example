# Локальная конфигурация document-service.
# Скопируйте файл в .env и замените значения generate-me на свои секреты.
# .env хранит реальные пароли и не должен попадать в Git.

# PostgreSQL — значения используются docker-compose.yml.
POSTGRES_DB=document_service
POSTGRES_USER=document_service
POSTGRES_PASSWORD=generate-me

# Общий секрет интеграции с CRM.
# Должен совпадать с CRM_DOCUMENT_SERVICE_TOKEN в настройках CRM.
CRM_DOCUMENT_SERVICE_TOKEN=generate-me

# Необязательный адрес обратного уведомления о сформированных документах.
# По умолчанию используется адрес из docker-compose.yml.
# CRM_EVENT_URL=http://chisto-crm:8000/api/v1/internal/document-service/events

# Если true, инспектор видит только заявки по адресам своей управы.
# Оставьте false, пока управы не заполнены.
RESTRICT_CASES_BY_uprava=false
