# Пароли базы: на сервере лежат в .env, в репозиторий не попадают.
.env
.env.*
!.env.example

# Ключи и сертификаты: закрытый ключ TLS в репозиторий не попадает.
nginx/certs/

# Данные работы: фотографии осмотров и собранные документы. В них персональные
# данные граждан и организаций — в репозиторий они не попадают.
data/
postgres/

# Служебное
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
*.log
*.tar.gz
