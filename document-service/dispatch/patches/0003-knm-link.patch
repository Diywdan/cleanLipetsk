По передаче материалов на КНМ сервис документов заводит выездное
обследование, поэтому в карточке обращения появилась строка «Обследование
№… заведено» со ссылкой в сервис (поля serviceUrl, inspection, knm в
IIncident). Пока обследования нет — подсказка, что его заведёт передача
на КНМ.
---
 src/entities/incident/types/index.ts          | 12 +++++++++++
 src/entities/incident/ui/card/CardActions.tsx | 21 +++++++++++++++++++
 2 files changed, 33 insertions(+)

diff --git a/src/entities/incident/types/index.ts b/src/entities/incident/types/index.ts
index 32de912..29b55f0 100644
--- a/src/entities/incident/types/index.ts
+++ b/src/entities/incident/types/index.ts
@@ -142,4 +142,16 @@ export interface IIncident {
     report?: IPhotoReport;    // подробности фотоотчёта
     boundingBoxes: IBoundingBox[];
   };
+  // ─── Связь с сервисом документов (наш бэкенд) ───
+  // В режиме стенда этих полей нет: там обращения живут в браузере.
+  serviceUrl?: string;        // карточка заявки в сервисе документов
+  inspection?: {              // выездное обследование, заведённое по обращению
+    id: number;
+    startedAt: string | null;
+    hasPhoto: boolean;
+  } | null;
+  knm?: {                     // отметки контрольно-надзорного контура
+    escalated: boolean;
+    dismissed: boolean;
+  };
 }
diff --git a/src/entities/incident/ui/card/CardActions.tsx b/src/entities/incident/ui/card/CardActions.tsx
index 9617caf..d652237 100644
--- a/src/entities/incident/ui/card/CardActions.tsx
+++ b/src/entities/incident/ui/card/CardActions.tsx
@@ -192,6 +192,27 @@ export const CardActions: React.FC<{ incident: IIncident; role: UserRole }> = ({
       return (
         <div className="flex flex-col gap-3">
           {note('bad', 'Срок устранения истёк. Материалы готовятся к передаче на контрольно-надзорное мероприятие.')}
+          {/* Связка с сервисом документов: по передаче на КНМ там заводится
+              выездное обследование, и дальше работа идёт по нему. */}
+          {incident.inspection ? (
+            <p className="m-0 text-[13.5px] text-muted-foreground">
+              Обследование №{incident.inspection.id} заведено
+              {incident.inspection.hasPhoto ? ', фотоматериал есть' : ', фотоматериал ещё не загружен'}.
+              {incident.serviceUrl && (
+                <>
+                  {' '}
+                  <a href={incident.serviceUrl} className="text-primary no-underline hover:underline">
+                    Открыть в сервисе документов
+                  </a>
+                </>
+              )}
+            </p>
+          ) : (
+            <p className="m-0 text-[13.5px] text-muted-foreground">
+              Обследование по обращению ещё не заведено: передайте материалы на КНМ, и
+              сервис документов заведёт выездное обследование.
+            </p>
+          )}
           {allowed('ISSUE_ACT') && (
             <Button
               onClick={async () => {
