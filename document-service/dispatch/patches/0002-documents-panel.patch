+import { API_URL, http } from '@/shared/api/http';
+import { EMPTY_DOCUMENTS, type IDocumentsApi, type IDocumentsState } from '../types';
+
+// Документы обращения. Сервис документов (наш бэкенд) собирает пакет по
+// официальным бланкам, считает листы и отдаёт готовые файлы; интерфейс
+// диспетчера показывает список и ссылки.
+//
+// В режиме стенда сервиса нет: панель говорит об этом, а кнопка формирования
+// документов остаётся прежней (PDF-заглушка в браузере).
+
+export function createHttpDocumentsApi(baseUrl: string): IDocumentsApi {
+  const path = (incidentId: string) =>
+    `/incidents/${encodeURIComponent(incidentId)}/documents`;
+
+  return {
+    available: true,
+    read: (incidentId) => http<IDocumentsState>(baseUrl, path(incidentId)),
+    // Сборка отвечает обращением целиком, поэтому состояние документов
+    // запрашиваем следом: так панель показывает уже собранный пакет.
+    build: async (incidentId) => {
+      await http(baseUrl, `/incidents/${encodeURIComponent(incidentId)}/act`, {
+        method: 'POST',
+        body: {},
+      });
+      return http<IDocumentsState>(baseUrl, path(incidentId));
+    },
+  };
+}
+
+export function createMockDocumentsApi(): IDocumentsApi {
+  return {
+    available: false,
+    read: async (incidentId) => ({ ...EMPTY_DOCUMENTS, incidentId }),
+    build: async (incidentId) => ({ ...EMPTY_DOCUMENTS, incidentId }),
+  };
+}
+
+export function createDocumentsApi(): IDocumentsApi {
+  return API_URL ? createHttpDocumentsApi(API_URL) : createMockDocumentsApi();
+}
