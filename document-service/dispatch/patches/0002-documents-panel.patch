+import React, { useCallback, useEffect, useState } from 'react';
+import { Archive, FileDown, FileText, Loader2, RefreshCw } from 'lucide-react';
+import { Button } from '@/components/ui/button';
+import { createDocumentsApi } from '../api/documentsApi';
+import { EMPTY_DOCUMENTS, type IDocumentsState } from '../types';
+
+// Панель документов в карточке обращения. Пакет собирает сервис документов:
+// здесь только список готовых бланков, число листов, скачивание и — если
+// собрать пока нельзя — что именно не заполнено.
+
+const documentsApi = createDocumentsApi();
+
+const stateOf = (documents: IDocumentsState): string => {
+  if (documents.packageId) return `пакет №${documents.packageId}`;
+  return 'пакет не собран';
+};
+
+const formatBuiltAt = (value: string | null): string => {
+  if (!value) return '';
+  try {
+    return new Date(value).toLocaleString('ru-RU', {
+      day: '2-digit',
+      month: '2-digit',
+      year: 'numeric',
+      hour: '2-digit',
+      minute: '2-digit',
+    });
+  } catch {
+    return value;
+  }
+};
+
+export const DocumentsPanel: React.FC<{ incidentId: string }> = ({ incidentId }) => {
+  const [documents, setDocuments] = useState<IDocumentsState>(EMPTY_DOCUMENTS);
+  const [loading, setLoading] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const load = useCallback(async () => {
+    if (!documentsApi.available) return;
+    setLoading(true);
+    setError(null);
+    try {
+      setDocuments(await documentsApi.read(incidentId));
+    } catch (e) {
+      setError(e instanceof Error ? e.message : 'Не удалось получить документы');
+    } finally {
+      setLoading(false);
+    }
+  }, [incidentId]);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  const build = async () => {
+    setBusy(true);
+    setError(null);
+    try {
+      setDocuments(await documentsApi.build(incidentId));
+    } catch (e) {
+      setError(e instanceof Error ? e.message : 'Не удалось собрать пакет');
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  // Режим стенда: сервиса документов рядом нет.
+  if (!documentsApi.available) {
+    return (
+      <p className="m-0 text-[13.5px] text-muted-foreground">
+        Демонстрационный режим: сервис документов не подключён, бланки не формируются.
+      </p>
+    );
+  }
+
+  return (
+    <div className="flex flex-col gap-3">
+      <div className="flex flex-wrap items-center justify-between gap-2">
+        <span className="font-num text-[12px] text-muted-foreground">
+          {stateOf(documents)}
+          {documents.builtAt ? ` · собран ${formatBuiltAt(documents.builtAt)}` : ''}
+          {loading ? ' · обновление…' : ''}
+        </span>
+        <div className="flex items-center gap-2">
+          {documents.archiveUrl && (
+            <a
+              href={documents.archiveUrl}
+              className="flex items-center gap-1.5 text-[13px] text-primary no-underline hover:underline"
+            >
+              <Archive className="size-4" /> Скачать архив
+            </a>
+          )}
+          {!documents.packageId && documents.canBuild && (
+            <Button onClick={build} disabled={busy} className="h-auto min-h-9 py-2 text-[13.5px]">
+              {busy ? <Loader2 className="animate-spin" /> : <FileDown />} Собрать пакет документов
+            </Button>
+          )}
+          {documents.packageId && (
+            <Button
+              onClick={build}
+              disabled={busy || !documents.canBuild}
+              variant="outline"
+              className="h-auto min-h-9 bg-transparent py-2 text-[13.5px]"
+            >
+              {busy ? <Loader2 className="animate-spin" /> : <RefreshCw />} Собрать заново
+            </Button>
+          )}
+        </div>
+      </div>
+
+      {documents.documents.length > 0 ? (
+        <ul className="m-0 flex list-none flex-col gap-1.5 p-0">
+          {documents.documents.map((document) => (
+            <li
+              key={document.id}
+              className="flex items-center justify-between gap-3 rounded-lg border border-border bg-[var(--inset)] px-3 py-2"
+            >
+              <span className="flex min-w-0 items-center gap-2">
+                <FileText className="size-4 shrink-0 text-muted-foreground" />
+                <span className="min-w-0">
+                  <span className="block truncate text-[13.5px] text-foreground">{document.title}</span>
+                  <span className="font-num block text-[11.5px] text-muted-foreground">
+                    {document.number ? `№ ${document.number}` : 'номер не присвоен'}
+                    {document.issuedOn ? ` · ${document.issuedOn.split('-').reverse().join('.')}` : ''}
+                    {document.pages ? ` · ${document.pages} л.` : ' · листы не посчитаны'}
+                  </span>
+                </span>
+              </span>
+              <a
+                href={document.downloadUrl}
+                className="shrink-0 text-[13px] text-primary no-underline hover:underline"
+              >
+                Скачать
+              </a>
+            </li>
+          ))}
+        </ul>
+      ) : (
+        !loading && (
+          <p className="m-0 text-[13.5px] text-muted-foreground">
+            {documents.canBuild
+              ? 'Пакет ещё не собран. Документы формируются по официальным бланкам.'
+              : 'Пакет пока нельзя собрать.'}
+          </p>
+        )
+      )}
+
+      {documents.missing.length > 0 && (
+        <div
+          className="rounded-md px-3 py-2.5 text-[13px] text-danger"
+          style={{ background: 'var(--st-knm-bg)' }}
+        >
+          <div className="font-semibold">Что нужно заполнить в сервисе документов:</div>
+          <ul className="m-0 mt-1.5 list-disc pl-4">
+            {documents.missing.slice(0, 6).map((item) => (
+              <li key={item}>{item}</li>
+            ))}
+          </ul>
+        </div>
+      )}
+
+      {error && (
+        <p role="alert" className="m-0 text-[13px] text-danger">
+          {error}
+          {/* Сервис документов закрыт сессией: без входа он отвечает 401. */}
+          {/вход|войти|Unauthorized|401/i.test(error) && (
+            <>
+              {' '}
+              <a href="/ui/login" className="text-primary no-underline hover:underline">
+                Войти в сервис документов
+              </a>
+            </>
+          )}
+        </p>
+      )}
+    </div>
+  );
+};
