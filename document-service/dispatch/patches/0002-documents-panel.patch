+// Документы обращения. Их формирует сервис документов (наш бэкенд): сам
+// интерфейс диспетчера бланки не рисует — он только показывает готовый пакет
+// и даёт скачать файлы.
+
+export interface IDocumentRef {
+  id: number;
+  code: string;
+  title: string;
+  number: string;
+  issuedOn: string | null;
+  pages: number | null;
+  downloadUrl: string;
+}
+
+export interface IDocumentsState {
+  incidentId: string;
+  packageKind: string | null;
+  packageId: number | null;
+  builtAt: string | null;
+  archiveUrl: string | null;
+  documents: IDocumentRef[];
+  canBuild: boolean;
+  missing: string[];
+}
+
+export interface IDocumentsApi {
+  // Есть ли сервис документов: в режиме стенда его нет, и панель об этом честно
+  // говорит вместо пустого списка.
+  readonly available: boolean;
+  read(incidentId: string): Promise<IDocumentsState>;
+  build(incidentId: string): Promise<IDocumentsState>;
+}
+
+export const EMPTY_DOCUMENTS: IDocumentsState = {
+  incidentId: '',
+  packageKind: null,
+  packageId: null,
+  builtAt: null,
+  archiveUrl: null,
+  documents: [],
+  canBuild: false,
+  missing: [],
+};
diff --git a/src/entities/document/ui/DocumentsPanel.tsx b/src/entities/document/ui/DocumentsPanel.tsx
