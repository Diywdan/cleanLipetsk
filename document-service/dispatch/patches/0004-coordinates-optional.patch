У адреса может не быть геометки (координаты заполняют в справочнике адресов).
Раньше такой адрес давал пару 0, 0, и метка уезжала в океан.

* IGeoLocation.coordinates допускает null;
* метки ставятся только для обращений с координатами;
* расстояние до площадки в фотоотчёте считается при известных координатах.
---
 src/entities/incident/types/index.ts              | 3 ++-
 src/entities/incident/ui/card/PhotoReportForm.tsx | 5 ++++-
 src/widgets/map-radar/lib/useIncidentMarkers.ts   | 3 +++
 3 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/entities/incident/types/index.ts b/src/entities/incident/types/index.ts
index 29b55f0..eaf79ba 100644
--- a/src/entities/incident/types/index.ts
+++ b/src/entities/incident/types/index.ts
@@ -40,7 +40,8 @@ export interface IGeoLocation {
   address: string;
   // [долгота, широта] — порядок Яндекс Карт v3. ФГИС УТКО и большинство реестров отдают
   // широту первой: при загрузке реальных данных пару нужно развернуть.
-  coordinates: [number, number];
+  // null — координат нет (адрес без геометки): метку на карте не ставим.
+  coordinates: [number, number] | null;
   cadastralNumber?: string;      // Кадастровый номер для подсветки полигона ответственности УК
   upravaId: number; // номер управы
   houseFias?: string;            // ФИАС дома, если сигнал пришёл по дому (домовой чат, ПОС)
diff --git a/src/entities/incident/ui/card/PhotoReportForm.tsx b/src/entities/incident/ui/card/PhotoReportForm.tsx
index 8b2349e..f7ed23a 100644
--- a/src/entities/incident/ui/card/PhotoReportForm.tsx
+++ b/src/entities/incident/ui/card/PhotoReportForm.tsx
@@ -44,7 +44,10 @@ export const PhotoReportForm: React.FC<{
       photoUrl: url,
       takenAt: at,
       coords: coords ?? undefined,
-      distanceM: coords ? distanceM(coords, incident.location.coordinates) : undefined,
+      distanceM:
+        coords && incident.location.coordinates
+          ? distanceM(coords, incident.location.coordinates)
+          : undefined,
     };
     await onSubmit(report);
     setBusy(false);
diff --git a/src/widgets/map-radar/lib/useIncidentMarkers.ts b/src/widgets/map-radar/lib/useIncidentMarkers.ts
index 6959548..625b7f7 100644
--- a/src/widgets/map-radar/lib/useIncidentMarkers.ts
+++ b/src/widgets/map-radar/lib/useIncidentMarkers.ts
@@ -32,6 +32,9 @@ export function useIncidentMarkers(mapReady: boolean, mapRef: React.RefObject<YM
     );
 
     ordered.forEach((incident) => {
+      // Адрес без координат: метку поставить некуда — снимок всё равно
+      // показал бы точку в океане.
+      if (!incident.location.coordinates) return;
       const isSelected = selectedIncident?.id === incident.id;
       const markerElement = createMarkerElement(
         incident.status,
