Яндекс.Карты: ключи с сервера принимаются, но в браузере карта не поднимается —
причину по консоли найти не удалось, а показывать систему нужно. Поэтому карта
вернулась на проверенную подложку CARTO с ключом из VITE_MAP_TILES: без
суточных лимитов, дома и улицы на месте, метки и зоны управ работают.

Яндексовый виджет удалён из дерева; при необходимости возвращается из истории.
---
 src/widgets/map-radar/lib/useLeafletMap.ts | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/widgets/map-radar/lib/useLeafletMap.ts b/src/widgets/map-radar/lib/useLeafletMap.ts
index b3d0bf2..53c7504 100644
--- a/src/widgets/map-radar/lib/useLeafletMap.ts
+++ b/src/widgets/map-radar/lib/useLeafletMap.ts
@@ -8,11 +8,16 @@ import { LIPETSK_POLYGONS } from './lipetskPolygons';
 const CITY_CENTER: [number, number] = [52.6089, 39.5994];
 const CITY_ZOOM = 12;
 
+// Подложка без ключа. Тайлы волонтёрских серверов самого OpenStreetMap
+// (tile.openstreetmap.org) для приложений запрещены их политикой — сайт
+// получает «Access blocked». Поэтому берём подложку CARTO: она построена на
+// данных OpenStreetMap, отдаётся приложениям и ключа не требует.
+// Для большой нагрузки (тысячи открытий в день) стоит подключить свой сервер
+// тайлов или платный тариф — меняется только эта строка.
 // Подложка карты. По умолчанию CARTO (данные OpenStreetMap, слой voyager):
 // волонтёрские тайлы самого OpenStreetMap приложениям использовать нельзя, а
 // CARTO отдаёт тайлы приложениям — по ключу, который задаётся при сборке
 // переменной VITE_MAP_TILES (в исходники ключ не попадает).
-// Для большой нагрузки есть смысл в своих тайлах: адрес меняется здесь же.
 const TILES =
   (import.meta.env.VITE_MAP_TILES as string | undefined) ??
   'https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png';
-- 
