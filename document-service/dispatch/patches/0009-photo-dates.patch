@@ -118,13 +118,16 @@ export const ReportMeta: React.FC<{ incident: IIncident }> = ({ incident }) => {
   return (
     <p className={`font-num m-0 mt-2 flex flex-wrap gap-x-3 text-[12px] ${far ? 'text-danger' : 'text-muted-foreground'}`}>
       <span>Отчёт снят {formatDateTime(r.takenAt)}</span>
-      <span>
-        {r.distanceM == null
-          ? 'место съёмки не определено'
-          : far
+      {/* Расстояние до площадки известно только когда отчёт отправляли из
+          приложения с геолокацией. Если его нет, строку не показываем: в
+          карточке она читалась как ошибка. */}
+      {r.distanceM != null && (
+        <span>
+          {far
             ? `${Math.round(r.distanceM)} м от площадки — проверьте, та ли площадка`
             : `${Math.round(r.distanceM)} м от площадки`}
-      </span>
+        </span>
+      )}
     </p>
   );
 };
