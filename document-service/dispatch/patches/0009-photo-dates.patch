-const TILES = 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png';
-const TILE_SUBDOMAINS = ['a', 'b', 'c', 'd'];
+// Подложка карты. По умолчанию CARTO (данные OpenStreetMap, слой voyager):
+// волонтёрские тайлы самого OpenStreetMap приложениям использовать нельзя, а
