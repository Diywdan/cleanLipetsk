Даты обеих сторон видны в бейджах сравнения, поэтому подпись «Обход инспектора ·
дата» под снимком и строка «Отчёт снят · дата» в карточке стали дублировать друг
друга. Обе убраны; строка фотоотчёта осталась только для предупреждения, когда
снимок сделан далеко от площадки.
---
 src/entities/incident/ui/card/PhotoReportForm.tsx |  6 ++++++
 src/entities/incident/ui/card/parts.tsx           | 14 ++------------
 2 files changed, 8 insertions(+), 12 deletions(-)

diff --git a/src/entities/incident/ui/card/PhotoReportForm.tsx b/src/entities/incident/ui/card/PhotoReportForm.tsx
index 17d9e70..b3119a3 100644
--- a/src/entities/incident/ui/card/PhotoReportForm.tsx
+++ b/src/entities/incident/ui/card/PhotoReportForm.tsx
@@ -115,6 +115,12 @@ export const ReportMeta: React.FC<{ incident: IIncident }> = ({ incident }) => {
   const r = incident.media.report;
   if (!r) return null;
   const far = r.distanceM != null && r.distanceM > REPORT_RADIUS_M;
+
+  // Даты обеих сторон видны в бейджах сравнения, поэтому строку под фото
+  // показываем только когда есть о чём предупредить: снимок сделан далеко
+  // от площадки.
+  if (!far) return null;
+
   return (
     <p className={`font-num m-0 mt-2 flex flex-wrap gap-x-3 text-[12px] ${far ? 'text-danger' : 'text-muted-foreground'}`}>
       <span>Отчёт снят {formatDateTime(r.takenAt)}</span>
diff --git a/src/entities/incident/ui/card/parts.tsx b/src/entities/incident/ui/card/parts.tsx
index 43abdf2..20fa230 100644
--- a/src/entities/incident/ui/card/parts.tsx
+++ b/src/entities/incident/ui/card/parts.tsx
@@ -2,7 +2,7 @@ import React from 'react';
 import type { IIncident, IHistoryEvent } from '../../types';
 import { ImageCompareSlider } from '@/shared/components/image-slider/ImageCompareSlider';
 import { ORGANIZATION_KIND_TITLE, RESPONSIBLE_ROLE_TITLE } from '../../lib/responsibles';
-import { SOURCE_TITLE, formatDateTime, typoQuotes } from '../../lib/presentation';
+import { formatDateTime, typoQuotes } from '../../lib/presentation';
 import { slaShare } from './cardModel';
 import { Bot, Building2, Settings, User } from 'lucide-react';
 
@@ -27,14 +27,10 @@ export const PhotoEvidence: React.FC<{
   incident: IIncident;
   showAi: boolean;
 }> = ({ incident, showAi }) => {
-  const { media, location, source, timeline } = incident;
+  const { media, location, timeline } = incident;
   const boxColor = 'var(--st-knm)';
   const frame = 'rounded-lg bg-black ring-1 ring-border';
 
-  // Подписи сторон сравнения. «Было» — когда зафиксировали нарушение (первый
-  // обход), «Стало» — когда исполнитель прислал фотоотчёт. Одна общая подпись
-  // на оба снимка показывала бы время первого обхода и там, и там.
-  const beforeCaption = `${SOURCE_TITLE[source].toUpperCase()} · ${formatDateTime(timeline.createdAt)}`;
 
   const picture = media.photoAfterUrl ? (
     <ImageCompareSlider
@@ -80,12 +76,6 @@ export const PhotoEvidence: React.FC<{
       <div className={`relative overflow-hidden ${frame}`}>
         {picture}
         <HudCorners />
-        {/* Для одиночного снимка подпись остаётся плашкой: бейджей слайдера тут нет. */}
-        {!media.photoAfterUrl && (
-          <span className="font-num pointer-events-none absolute bottom-2.5 left-3 z-30 rounded bg-black/55 px-1.5 py-0.5 text-[11px] text-white/85">
-            {beforeCaption}
-          </span>
-        )}
 
       </div>
     </figure>
