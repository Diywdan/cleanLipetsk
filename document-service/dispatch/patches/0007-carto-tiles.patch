Волонтёрские тайлы tile.openstreetmap.org запрещены для приложений: их служба
ответила страницей «Access blocked — App is not following the tile usage
policy», и карта превратилась в решётку отказов.

Подложка заменена на CARTO (слой voyager, данные OpenStreetMap): та же
география с домами, но тайлы отдаются приложениям и ключа не требуют.
Авторство указано на карте: «© OpenStreetMap, © CARTO».
---
 src/widgets/map-radar/lib/useLeafletMap.ts | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/src/widgets/map-radar/lib/useLeafletMap.ts b/src/widgets/map-radar/lib/useLeafletMap.ts
index fca1171..b1a498c 100644
--- a/src/widgets/map-radar/lib/useLeafletMap.ts
+++ b/src/widgets/map-radar/lib/useLeafletMap.ts
@@ -8,10 +8,15 @@ import { LIPETSK_POLYGONS } from './lipetskPolygons';
 const CITY_CENTER: [number, number] = [52.6089, 39.5994];
 const CITY_ZOOM = 12;
 
-// Подложка OpenStreetMap: ни ключей, ни аккаунтов, ни лимитов, а дома
-// нарисованы контурами — по ним и видно, куда встала метка.
-const TILES = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png';
-const ATTRIBUTION = '© OpenStreetMap';
+// Подложка без ключа. Тайлы волонтёрских серверов самого OpenStreetMap
+// (tile.openstreetmap.org) для приложений запрещены их политикой — сайт
+// получает «Access blocked». Поэтому берём подложку CARTO: она построена на
+// данных OpenStreetMap, отдаётся приложениям и ключа не требует.
+// Для большой нагрузки (тысячи открытий в день) стоит подключить свой сервер
+// тайлов или платный тариф — меняется только эта строка.
+const TILES = 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png';
+const TILE_SUBDOMAINS = ['a', 'b', 'c', 'd'];
+const ATTRIBUTION = '© OpenStreetMap, © CARTO';
 
 interface Result {
   mapReady: boolean;
@@ -38,7 +43,11 @@ export function useLeafletMap(
         attributionControl: true,
       });
 
-      L.tileLayer(TILES, { maxZoom: 19, attribution: ATTRIBUTION }).addTo(map);
+      L.tileLayer(TILES, {
+        maxZoom: 19,
+        subdomains: TILE_SUBDOMAINS,
+        attribution: ATTRIBUTION,
+      }).addTo(map);
 
       // Зоны ответственности управ: контуры берём из данных, цвет — оттуда же.
       // В исходных данных порядок как в Яндекс Картах — [долгота, широта],
