+import { API_URL, http } from '@/shared/api/http';
+import type { IUser, UserRole } from '../types';
+
+// Кто вошёл — спрашиваем у сервиса документов. Вход у двух интерфейсов общий:
+// сессия в куке, которую ставит страница входа сервиса. Поэтому здесь только
+// чтение пользователя и выход; пароля интерфейс диспетчера не видит.
+//
+// В режиме стенда сервиса нет: там остаётся прежний переключатель ролей.
+
+export interface ICurrentUser {
+  id: number;
+  name: string;
+  email: string;
+  role: UserRole;          // роль в терминах интерфейса диспетчера
+  serviceRole: string;     // код нашей роли: administrator, manager, inspector…
+  serviceRoleTitle: string; // название нашей роли для человека
+  isAdmin: boolean;
+  canEdit: boolean;
+  loginUrl: string;
+  logoutUrl: string;
+}
+
+export function loginUrl(nextPath: string): string {
+  return `/ui/login?next=${encodeURIComponent(nextPath)}`;
+}
+
+export function toUser(me: ICurrentUser): IUser {
+  return {
+    id: String(me.id),
+    name: me.name,
+    role: me.role,
+    // Подразделение в их модели — код ведомства; у нас его нет, оставляем ДРТ,
+    // а человеку показываем название его роли отдельным полем.
+    department: 'DRT',
+    serviceRoleTitle: me.serviceRoleTitle,
+  };
+}
+
+export async function fetchMe(): Promise<ICurrentUser> {
+  if (!API_URL) throw new Error('Сервис документов не подключён');
+  return http<ICurrentUser>(API_URL, '/me');
+}
+
+export async function logout(logoutPath: string): Promise<void> {
+  if (!API_URL) return;
+  await http(API_URL, logoutPath.replace(/^\/api/, ''), { method: 'POST', body: {} });
+}
