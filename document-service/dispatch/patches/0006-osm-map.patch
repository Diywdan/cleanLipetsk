@@ -0,0 +1,76 @@
+import { useEffect, useRef, useState } from 'react';
+import L from 'leaflet';
+import 'leaflet/dist/leaflet.css';
+import './map.css';
+import { LIPETSK_POLYGONS } from './lipetskPolygons';
+
+// Центр Липецка: карта открывается на городе, а не на середине мира.
+const CITY_CENTER: [number, number] = [52.6089, 39.5994];
+const CITY_ZOOM = 12;
+
+// Подложка OpenStreetMap: ни ключей, ни аккаунтов, ни лимитов, а дома
+// нарисованы контурами — по ним и видно, куда встала метка.
+const TILES = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png';
+const ATTRIBUTION = '© OpenStreetMap';
+
+interface Result {
+  mapReady: boolean;
+  error: string | null;
+  mapRef: React.RefObject<L.Map | null>;
+}
+
+export function useLeafletMap(
+  containerRef: React.RefObject<HTMLDivElement | null>,
+): Result {
+  const mapRef = useRef<L.Map | null>(null);
+  const [mapReady, setMapReady] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    const container = containerRef.current;
+    if (!container || mapRef.current) return;
+
+    try {
+      const map = L.map(container, {
+        center: CITY_CENTER,
+        zoom: CITY_ZOOM,
+        zoomControl: true,
+        attributionControl: true,
+      });
+
+      L.tileLayer(TILES, { maxZoom: 19, attribution: ATTRIBUTION }).addTo(map);
+
+      // Зоны ответственности управ: контуры берём из данных, цвет — оттуда же.
+      // В исходных данных порядок как в Яндекс Картах — [долгота, широта],
+      // поэтому пару разворачиваем.
+      LIPETSK_POLYGONS.forEach((polygon) => {
+        const rings = (polygon.coordinates ?? []) as unknown as number[][][];
+        const latLngs = rings.map((ring) =>
+          ring.map(([lon, lat]) => [lat, lon] as [number, number]),
+        );
+        if (!latLngs.length) return;
+        L.polygon(latLngs, {
+          color: polygon.color ?? '#0D4CD3',
+          weight: 1.5,
+          fillColor: polygon.color ?? '#0D4CD3',
+          fillOpacity: 1,
+        }).addTo(map);
+      });
+
+      mapRef.current = map;
+      setMapReady(true);
+      // Контейнер мог получить размер уже после создания карты.
+      window.setTimeout(() => map.invalidateSize(), 0);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : 'Не удалось построить карту');
+    }
+
+    return () => {
+      mapRef.current?.remove();
+      mapRef.current = null;
+      setMapReady(false);
+    };
+  }, [containerRef]);
+
+  return { mapReady, error, mapRef };
+}
